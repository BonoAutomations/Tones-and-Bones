X_ACCESS_SECRET=your_x_access_secret

# ─── X / Twitter (Secondary: @AiSales2782) ───────────────────────────────────
X_SECONDARY_API_KEY=your_secondary_x_api_key
X_SECONDARY_API_SECRET=your_secondary_x_api_secret
