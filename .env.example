WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=biz_5KCxJ8AxaVhU8R
WHOP_STORE_URL=https://whop.com/real-estate-automations

# ─── Stripe ───────────────────────────────────────────────────────────────────
