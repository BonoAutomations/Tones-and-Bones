# Trading Bot Configuration
# Copy this file to .env and fill in your values

# ─── Exchange Selection ─────────────────────────────────────────────────────
# Choose ONE exchange: mock | coinbase | cryptocom | binance
EXCHANGE=mock

# ─── Coinbase Advanced Trade ────────────────────────────────────────────────
# Get keys at: https://www.coinbase.com/settings/api  (Advanced Trade tab)
# Two key types are supported:
#   1. CDP API Keys (recommended) — apiSecret is a PEM EC private key
#   2. Legacy API keys — apiSecret is a plain secret string
COINBASE_API_KEY=organizations/xxx/apiKeys/yyy
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# Note: Coinbase uses USDC not USDT. BTC/USDT is treated as BTC/USDC automatically.

# ─── Crypto.com Exchange ────────────────────────────────────────────────────
# Get keys at: https://crypto.com/exchange/settings/api-key
CRYPTOCOM_API_KEY=your_api_key_here
CRYPTOCOM_API_SECRET=your_api_secret_here

# ─── Binance (optional) ─────────────────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
EXCHANGE_TESTNET=true

# ─── Active exchange credentials (used by the bot) ──────────────────────────
# Copy the right keys above into these variables based on EXCHANGE= setting
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# ─── Trading Configuration ───────────────────────────────────────────────────
TRADING_PAIR=BTC/USDT
BASE_CURRENCY=USDT
QUOTE_CURRENCY=BTC
STRATEGY=moving_average          # moving_average | rsi | combined

# ─── Risk Management ─────────────────────────────────────────────────────────
MAX_POSITION_SIZE=0.1            # Max 10% of portfolio per trade
MAX_DAILY_LOSS=0.05              # Stop trading if daily loss exceeds 5%
STOP_LOSS_PERCENT=0.02           # 2% stop loss per trade
TAKE_PROFIT_PERCENT=0.04         # 4% take profit per trade
MAX_OPEN_POSITIONS=3             # Maximum concurrent open positions

# ─── Strategy Parameters (Moving Average) ────────────────────────────────────
MA_FAST_PERIOD=9
MA_SLOW_PERIOD=21
MA_SIGNAL_PERIOD=5

# ─── Strategy Parameters (RSI) ───────────────────────────────────────────────
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# ─── Bot Behavior ─────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=60000           # How often to check prices (ms)
DRY_RUN=true                     # Paper trading mode (no real orders)
LOG_LEVEL=info                   # error | warn | info | debug

# ─── Circuit Breaker ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=5      # Failures before circuit opens
CIRCUIT_BREAKER_TIMEOUT_MS=60000 # How long circuit stays open (ms)

# ─── Retry Configuration ─────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# ─── Polymarket (Prediction Market) ─────────────────────────────────────────
# Polymarket trades YES/NO outcome tokens, not spot crypto.
# Prices = probabilities (0.00–1.00). Settlement in USDC on Polygon.
# Get a Polygon wallet private key from MetaMask:
#   MetaMask → Account Details → Export Private Key
# Fund the wallet with USDC on Polygon (via Coinbase → Polygon network)
POLYMARKET_PRIVATE_KEY=0xyour_polygon_wallet_private_key_here

# When EXCHANGE=polymarket, set these:
# EXCHANGE_API_SECRET=$POLYMARKET_PRIVATE_KEY  (private key used for signing)
# STRATEGY=polymarket
# TRADING_PAIR=<YES token ID from searchMarkets()>
# Example token IDs look like: 0x1234...abcd (64 hex chars)

# Polymarket strategy thresholds
POLYMARKET_BUY_THRESHOLD=0.35   # Buy YES if probability < 35%
POLYMARKET_SELL_THRESHOLD=0.70  # Sell YES if probability > 70%
POLYMARKET_MIN_LIQUIDITY=1000   # Minimum market liquidity ($)

# ─── Not Supported for Automated Trading ─────────────────────────────────────
# Webull: No public crypto trading API. Use their app manually.
# MetaMask: Browser wallet — use private key directly with Polymarket above.
