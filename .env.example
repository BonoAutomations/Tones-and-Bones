WHOP_COMPANY_ID=biz_FXXg2Q0Rwg1KhE
WHOP_STORE_URL=https://whop.com/automated-sales-solutions

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── X / Twitter (Primary: @Bono_1033) ───────────────────────────────────────
# Get from developer.x.com — add credits before enabling auto-post
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
