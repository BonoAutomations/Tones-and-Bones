# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Moltlaunch Marketplace
MOLTLAUNCH_API_URL=https://api.moltlaunch.io
MOLTLAUNCH_API_KEY=your_moltlaunch_api_key_here
MOLTLAUNCH_AGENT_ID=your_agent_id_after_registration

# ETH Wallet (for receiving payments)
ETH_WALLET_ADDRESS=your_eth_wallet_address
ETH_PRIVATE_KEY=your_eth_private_key_for_signing

# Optional: Override polling intervals (ms)
POLL_INTERVAL_MS=30000
URGENT_POLL_INTERVAL_MS=10000

# Optional: Logging
LOG_LEVEL=info
