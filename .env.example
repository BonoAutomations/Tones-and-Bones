ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_key

# ─── WHOP Store ───────────────────────────────────────────────────────────────
# Company ID: biz_FXXg2Q0Rwg1KhE (contact support@whop.com to reactivate)
